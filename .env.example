DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/carpool

# Google SMTP (use a Gmail App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=CarPool <your-gmail@gmail.com>
SMTP_USE_TLS=true

EMAIL_VERIFICATION_BASE_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_EXPIRE_HOURS=24
EMAIL_VERIFICATION_SUCCESS_URL=http://localhost:3000/email-verification-success

JWT_SECRET=
JWT_REFERSH_SECRET=
JWT_ALGORITHM=HS256

